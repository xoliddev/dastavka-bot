# Copy this file to .env and fill in real values. Never commit .env.

# ── Telegram ─────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=123456789:replace-me
# Comma-separated Telegram user IDs that are admins. This list is the ONLY source
# of admin rights: removing an id here revokes admin access on the user's next update.
ADMIN_IDS=111111111,222222222
# Optional: group/supergroup chat ID for order notifications (run /set_group in the group to get it)
NOTIFICATION_GROUP_ID=

# ── PostgreSQL ───────────────────────────────────────────
# Either a full DSN...
DATABASE_URL=
# ...or the individual parts (also read by the postgres container in docker-compose.yml)
POSTGRES_USER=dastavka
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dastavka
# "localhost" when running the bot on the host; docker compose overrides it with "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# ── Redis (FSM storage) ──────────────────────────────────
# Either a full URL (redis://host:6379/0)...
REDIS_URL=
# ...or the parts; docker compose overrides REDIS_HOST with "redis"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Business settings ────────────────────────────────────
# IANA timezone of the cafe; working hours and "today" reports use it
TIMEZONE=Asia/Tashkent

# ── Reverse geocoding (OpenStreetMap Nominatim) ──────────
# Nominatim's usage policy requires an identifying User-Agent with contact info.
NOMINATIM_USER_AGENT=dastavka-bot/2.0 (+https://github.com/xoliddev/dastavka-bot)
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
# Minimum seconds between requests (policy: max 1 request/second)
NOMINATIM_MIN_INTERVAL=1.0
# Number of reverse-geocoding results kept in memory
GEOCODER_CACHE_SIZE=1024

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
# "text" for humans, "json" for log collectors
LOG_FORMAT=text

# ── Tests only ───────────────────────────────────────────
# If set, pytest uses this database (it is TRUNCATED between tests!).
# If unset, tests start a throw-away postgres:16 container via Docker.
# TEST_DATABASE_URL=postgresql://test:test@localhost:5432/dastavka_test
